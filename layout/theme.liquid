    const dt = new Date();
    let addedDays = 0;
    
    while (addedDays < daysToAdd) {
      dt.setDate(dt.getDate() + 1);
      
      // Verifica se não é fim de semana (0 = Domingo, 6 = Sábado)
      if (dt.getDay() !== 0 && dt.getDay() !== 6) {
        addedDays++;
      }
    }
    
    return dt;
  }
  
  // Formata a data em pt-BR
