{%- liquid
  assign media_layout = section.settings.gallery_layout | default: 'carousel'
  assign mobile_thumbnails = section.settings.mobile_thumbnails | default: 'hide'
  assign enable_image_zoom = section.settings.enable_image_zoom | default: false
  assign enable_sticky_info = section.settings.enable_sticky_info

  assign product_class = 'product--mobile-thumbs-' | append: mobile_thumbnails
  assign product_class = product_class | append: ' product--' | append: section.settings.media_size
  assign product_class = product_class | append: ' product--' | append: media_layout
  assign product_class = product_class | append: ' product--media-has-' | append: product.media.size
  if product.media.size > 1
    assign product_class = product_class | append: ' product--media-has-many'
  endif

  case media_layout
    when 'grid-mix'
      assign media_modulo = product.media.size | modulo: 3
      if media_modulo == 2
        assign product_class = product_class | append: ' product--odd-media'
      endif
  endcase
-%}

{% render 'structured-data' %}

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  class="section block section-{{ section.id }} section--padding page-width color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag: preload: true }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag: preload: true }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag: preload: true }}
  {% endunless %}
  {%- assign has_models = product.media | where: 'media_type', 'model' | first -%}
  {%- if has_models -%}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  {%- if enable_image_zoom -%}
    <link
      id="Photoswipe"
      rel="stylesheet"
      href="{{ 'photoswipe-component.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

  {%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="product flex flex-wrap {{ product_class }}">
    {%- if product.media.size > 0 -%}
      <div class="product__media-wrapper block w-full relative">
        <div class="product__media-container{% if enable_sticky_info %} sticky-element{% endif %}">
          {% render 'product-media-gallery',
            media_layout: media_layout,
            mobile_thumbnails: mobile_thumbnails,
            variant_images: variant_images,
            enable_image_zoom: enable_image_zoom
          %}
          {% render 'product-information-below-media' %}
        </div>
      </div>
    {%- endif -%}
    <div class="product__info-wrapper block w-full">
      {% render 'product-information-blocks', enable_sticky_info: enable_sticky_info, update_browser_history: true %}
    </div>
  </div>
  <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>
  {%- if enable_image_zoom -%}
    <script src="{{ 'photoswipe.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if product.media.size > 0 -%}
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if has_models -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <!-- =============== Scripts de atualização de preços e cashback =============== -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    FoxTheme.pubsub.subscribe(FoxTheme.pubsub.PUB_SUB_EVENTS.variantChange, function(payload) {
      var newVariant = payload.data.variant;
      if (!newVariant) return;

      // 1) Preço original (centavos)
      var originalCents = newVariant.price; 

      // 2) Preço com 10% off (no Pix)
      var discountCents = Math.floor(originalCents * 0.9);

      // 3) Formatar ambos para moeda
      var originalFormatted = formatCurrency(originalCents);
      var discountFormatted = formatCurrency(discountCents);

      // 4) Atualizar Preço no Pix
      var pixPriceEl = document.getElementById('PixPrice-{{ section.id }}');
      if (pixPriceEl) {
        pixPriceEl.textContent = discountFormatted;
      }

      // 5) Atualizar Preço Original
      var originalEl = document.getElementById('OriginalPrice-{{ section.id }}');
      if (originalEl) {
        originalEl.textContent = originalFormatted;
      }

      // 6) Atualizar Parcelas (12x do Preço Original)
      var monthlyCents = Math.floor(originalCents / 12);
      var monthlyFormatted = formatCurrency(monthlyCents);

      var installmentsEl = document.getElementById('Installments-{{ section.id }}');
      if (installmentsEl) {
        installmentsEl.textContent = `em até 12x de ${monthlyFormatted} sem juros`;
      }

    });

    function formatCurrency(cents) {
      return new Intl.NumberFormat('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      }).format(cents / 100);
    }
  });
  </script>

  <!-- Script do parcelamento (InstallmentText-{{ section.id }}) -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    FoxTheme.pubsub.subscribe(FoxTheme.pubsub.PUB_SUB_EVENTS.variantChange, function(payload) {
      var newVariant = payload.data.variant;
      if (!newVariant) return;

      var priceInCents = newVariant.price;
      var monthlyInCents = Math.floor(priceInCents / 12);
      var monthlyFormatted = new Intl.NumberFormat('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      }).format(monthlyInCents / 100);

      var installmentEl = document.getElementById('InstallmentText-{{ section.id }}');
      if (installmentEl) {
        installmentEl.textContent = `em até 12x de ${monthlyFormatted} sem juros`;
      }
    });
  });
  </script>

  <!-- Script do Cashback (CashbackValue) -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    FoxTheme.pubsub.subscribe(FoxTheme.pubsub.PUB_SUB_EVENTS.variantChange, function(payload) {
      var newVariant = payload.data.variant;
      if (!newVariant) return;

      var priceInCents = newVariant.price;
      var cashbackInCents = Math.round(priceInCents * 0.05);
      var cashbackFormatted = new Intl.NumberFormat('pt-BR', {
        style: 'currency', currency: 'BRL'
      }).format(cashbackInCents / 100);

      var el = document.getElementById('CashbackValue');
      if (el) {
        el.innerHTML = `+${cashbackFormatted} <span style="font-size: 1rem; font-weight: 400;">voltam para você</span>`;
      }
    });
  });
  </script>

</product-info>

<!-- Indicador de Estoque e Unidades Vendidas -->


<!-- CSS para o indicador de estoque -->
<style>
  /* Container para os indicadores */
  .product-stock-container {
    display: flex;
    align-items: center;
    margin-top: 16px;
    padding-left: 4px;
    flex-wrap: wrap;
  }
  
  /* Indicador "Em estoque" */
  .product-stock-indicator {
    display: flex;
    align-items: center;
  }
  
  .stock-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0d8756;
  }
  
  .stock-dot::before,
  .stock-dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: transparent;
    border: 1.5px solid rgba(13, 135, 86, 0.6);
    transform: translate(-50%, -50%);
    animation: ripple 2s infinite ease-out;
  }
  
  .stock-dot::after {
    animation-delay: 0.6s;
  }
  
  @keyframes ripple {
    0% {
      width: 0;
      height: 0;
      opacity: 1;
    }
    100% {
      width: 18px;
      height: 18px;
      opacity: 0;
    }
  }
  
  .stock-text {
    font-size: 1rem;
    color: #999;
    margin-left: 8px;
  }
  
  /* Indicador "Unidades vendidas" */
  .product-sales-indicator {
    display: flex;
    align-items: center;
    margin-left: 8px;
  }
  
  .sales-separator {
    color: #999;
    margin-right: 8px;
    font-size: 0.9rem;
  }
  
  .sales-text {
    font-size: 1rem;
    color: #999;
  }
  
  #SalesCount-{{ section.id }} {
    font-weight: 500;
  }
</style>

<!-- Script para atualizar unidades vendidas -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Função inicial para a variante padrão
    updateSalesCount({{ product.selected_or_first_available_variant.price | json }}, "{{ product.handle | escape }}");
    
    // Escutar eventos de mudança de variante
    FoxTheme.pubsub.subscribe(FoxTheme.pubsub.PUB_SUB_EVENTS.variantChange, function(payload) {
      if (!payload || !payload.data || !payload.data.variant) return;
      
      var newVariant = payload.data.variant;
      var priceInCents = newVariant.price;
      var productHandle = "{{ product.handle | escape }}";
      
      // Atualizar o contador de vendas com base no preço da nova variante
      updateSalesCount(priceInCents, productHandle);
    });
    
    // Função para calcular e atualizar o contador de vendas
    function updateSalesCount(priceInCents, productHandle) {
      var salesCountElement = document.getElementById('SalesCount-{{ section.id }}');
      if (!salesCountElement) return;
      
      // Converter o preço de centavos para reais
      var PixPrice = priceInCents / 100;
      
      // Gerar seed consistente baseada no handle do produto
      var seedValue = generateSeedFromHandle(productHandle);
      
      // Fatores de variação baseados na data
      var today = new Date();
      var dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));
      var dayFactor = ((seedValue + dayOfYear) % 7) - 3; // Variação de -3 a +3
      
      // Determinar faixas baseadas no preço
      var minSales, maxSales;
      
      // Definir faixas de preço com valores específicos
      if (price < 100) {
        minSales = 27;
        maxSales = 238;
      } else if (price < 200) {
        minSales = 79;
        maxSales = 123;
      } else if (price < 300) {
        minSales = 62;
        maxSales = 97;
      } else if (price < 500) {
        minSales = 43;
        maxSales = 86;
      } else if (price < 700) {
        minSales = 31;
        maxSales = 67;
      } else if (price < 1000) {
        minSales = 24;
        maxSales = 53;
      } else if (price < 1500) {
        minSales = 45;
        maxSales = 75;
      } else if (price < 2000) {
        minSales = 35;
        maxSales = 60;
      } else if (price < 3000) {
        minSales = 25;
        maxSales = 45;
      } else if (price < 5000) {
        minSales = 18;
        maxSales = 35;
      } else if (price < 7000) {
        minSales = 12;
        maxSales = 28;
      } else if (price < 10000) {
        minSales = 9;
        maxSales = 22;
      } else if (price < 15000) {
        minSales = 7;
        maxSales = 16;
      } else if (price < 20000) {
        minSales = 5;
        maxSales = 12;
      } else if (price < 30000) {
        minSales = 3;
        maxSales = 9;
      } else {
        // Acima de R$ 30.000
        minSales = 1;
        maxSales = 5;
      }
      
      // Gerar número dentro da faixa
      var range = maxSales - minSales;
      var baseNumber = minSales + pseudoRandom(seedValue) * range;
      
      // Aplicar variações para números não arredondados
      var salesCount = Math.floor(baseNumber) + dayFactor;
      
      // Adicionar variação baseada no preço da variante (último dígito)
      var priceLastDigit = Math.floor(price) % 10;
      salesCount += (priceLastDigit % 3) - 1; // Adiciona -1, 0 ou 1
      
      // Garantir limites
      salesCount = Math.max(minSales, Math.min(salesCount, maxSales));
      
      // Atualizar o elemento no DOM
      salesCountElement.textContent = salesCount;
    }
    
    // Função para gerar número pseudoaleatório baseado em semente
    function pseudoRandom(seed) {
      var x = Math.sin(seed) * 10000;
      return x - Math.floor(x);
    }
    
    // Função para gerar valor de semente a partir do handle do produto
    function generateSeedFromHandle(handle) {
      var sum = 0;
      for (var i = 0; i < handle.length; i++) {
        sum += handle.charCodeAt(i) * (i + 1);
      }
      return sum;
    }
  });
</script>

