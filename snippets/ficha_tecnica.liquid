 <div class="ficha_tecnica">
    <details
      class="accordion-details"
      is="accordion-group"
      {% if block.settings.default_open %}open aria-expanded="true"{% else %}aria-expanded="false"{% endif %}
    >
      <summary class="accordion-details__summary flex items-center justify-between focus-inset">
        <div class="flex items-center gap-2">
          {% if block.settings.icon != 'none' %}
            {% render 'icons', icon: block.settings.icon, size: 'extra-large' %}
          {% endif %}
          <h2 class="{{ block.settings.heading_size }} inline-richtext">
            {{ block.settings.heading }}
          </h2>
        </div>
        {% render 'icon-plus-toggle' %}
      </summary>

      <div class="accordion-details__content rte">
        {{ block.settings.content }}
        {{ block.settings.page.content }}
        
        <table style="width:100%;border-collapse:collapse;">
          <tbody>

            
{% assign color_metaobjects = product.metafields.shopify["color-pattern"].value %}
{% assign color_list = "" %}

{% for color_metaobject in color_metaobjects %}
  {% assign this_color = color_metaobject.label %}
  
  {% if color_list == "" %}
    {% assign color_list = this_color %}
  {% else %}
    {% assign color_list = color_list | append: ", " | append: this_color %}
  {% endif %}
{% endfor %}

<tr>
  <th>Cor</th>
  <td>{{ color_list | default: "N/A" }}</td>
</tr>





            

                  {%- if product.metafields.custom.material.value != blank %}
                  <tr>
                    <th>Material</th>
                    <td>
                      {{ product.metafields.custom.material.value | remove: '[' | remove: ']' | remove: '"' }}
                    </td>
                  </tr>
                  {%- endif -%}

