              </tr>
            {% endif %}
            <!-- Repita para outros Metafields -->
          </tbody>
        </table>
      </div>
    </details>
  </div>

  {% if block.settings.show_below_product_media %}
    {% assign blocks_below_media = blocks_below_media | append: ficha_tecnica_html %}
  {% else %}
    {{ ficha_tecnica_html }}
  {% endif %}