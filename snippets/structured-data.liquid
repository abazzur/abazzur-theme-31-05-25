<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qual é o prazo de entrega dos produtos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nosso prazo de entrega é de 5 a 10 dias úteis para todo o Brasil. Para São Paulo e região, pode ser reduzido para 4 a 7 dias úteis. Após a confirmação do pagamento, enviamos um código de rastreamento."
      }
    },
    {
      "@type": "Question",
      "name": "Os produtos possuem garantia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, as luminárias possuem garantia de 12 meses oferecida pela loja, além de até 3 anos de garantia do fabricante, conforme o modelo."
      }
    },
    {
      "@type": "Question",
      "name": "Como posso solicitar a devolução de um produto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "O cliente tem até 7 dias corridos após o recebimento para solicitar a devolução, por meio do e-mail sac@abazzur.com, informando o número do pedido e o motivo."
      }
    },
    {
      "@type": "Question",
      "name": "A ABAZZUR™ emite nota fiscal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, todas as compras acompanham nota fiscal, que é enviada automaticamente para o e-mail cadastrado após a confirmação do pagamento."
      }
    },
    {
      "@type": "Question",
      "name": "Quais são as formas de pagamento disponíveis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aceitamos cartão de crédito (parcelado em até 12 vezes sem juros) e PIX, com condições especiais aplicadas no checkout."
      }
    },
    {
      "@type": "Question",
      "name": "Qual a diferença entre luz quente, neutra e fria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Luz quente (2700K-3000K) cria ambiente aconchegante; luz neutra (4000K) equilibra os tons; e luz fria (5000K-6500K) é ideal para ambientes que exigem concentração."
      }
    },
    {
      "@type": "Question",
      "name": "A ABAZZUR™ oferece cupons de desconto?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, cupons de desconto estão disponíveis para primeira compra e compras recorrentes. Confira as condições na seção 'Cupons' do site."
      }
    },
    {
      "@type": "Question",
      "name": "Como posso entrar em contato com a ABAZZUR™?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Você pode entrar em contato pelo e-mail contato@abazzur.com para dúvidas gerais ou pelo e-mail sac@abazzur.com para assuntos de pedidos e pós-venda. Também atendemos via WhatsApp (11) 5104-1636."
      }
    },
    {
      "@type": "Question",
      "name": "É possível parcelar a compra?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, compras com cartão de crédito podem ser parceladas em até 12 vezes sem juros, sem valor mínimo por parcela."
      }
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Início",
      "item": "{{ shop.url }}"
    }
    {%- if collection -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title }}",
      "item": "{{ shop.url }}{{ collection.url }}"
    }
    {%- endif -%},
    {
      "@type": "ListItem",
      "position": {%- if collection -%}3{%- else -%}2{%- endif -%},
      "name": "{{ product.title }}",
      "item": "{{ shop.url }}{{ product.url }}"
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.title }}",
  "description": "{{ product.description | strip_html | truncate: 300 }}",
  "sku": "{{ product.variants.first.sku }}",
  "category": "{{ product.type }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "brand": {
    "@type": "Brand",
    "name": "{{ product.vendor }}"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ product.variants.first.price | money_without_currency }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "{{ shop.name }}"
    }
  },
  "shippingDetails": {
    "@type": "OfferShippingDetails",
    "shippingRate": {
      "@type": "MonetaryAmount",
      "value": "0.00",
      "currency": "{{ cart.currency.iso_code }}"
    },
    "shippingDestination": {
      "@type": "Country",
      "name": "Brasil"
    },
    "deliveryTime": {
      "@type": "ShippingDeliveryTime",
      "handlingTime": {
        "@type": "QuantitativeValue",
        "minValue": 0,
        "maxValue": 1,
        "unitCode": "DAY"
      },
      "transitTime": {
        "@type": "QuantitativeValue",
        "minValue": 5,
        "maxValue": 10,
        "unitCode": "DAY"
      }
    },
    "businessDays": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "https://schema.org/Monday",
        "https://schema.org/Tuesday",
        "https://schema.org/Wednesday",
        "https://schema.org/Thursday",
        "https://schema.org/Friday"
      ],
      "opens": "09:00",
      "closes": "17:00"
    },
    "shippingMethod": "https://schema.org/ParcelService"
  },
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "name": "Política de Devolução da ABAZZUR",
    "url": "https://abazzur.com/pages/politica-de-reembolso",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 7,
    "applicableCountry": "BR",
    "returnMethod": "https://schema.org/ReturnByMail",
    "returnFees": "https://schema.org/FreeReturn",
    "itemCondition": "https://schema.org/NewCondition",
    "refundType": "https://schema.org/FullRefund",
    "additionalProperty": [
      {
        "@type": "PropertyValue",
        "name": "Prazo para devolução por arrependimento",
        "value": "7 dias após o recebimento"
      },
      {
        "@type": "PropertyValue",
        "name": "Prazo para devolução por defeito",
        "value": "30 dias após o recebimento"
      },
      {
        "@type": "PropertyValue",
        "name": "Método de devolução",
        "value": "Correios"
      },
      {
        "@type": "PropertyValue",
        "name": "Custo da devolução",
        "value": "Grátis"
      }
    ]
  },
{%- if product.metafields.reviews.recent_reviews.value != blank -%}
"review": [
  {%- for review in product.metafields.reviews.recent_reviews.value limit: 5 -%}
  {
    "@type": "Review",
    "author": "{{ review.author }}",
    "datePublished": "{{ review.date }}",
    "reviewBody": "{{ review.content }}",
    "name": "{{ review.title }}",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "{{ review.rating }}",
      "bestRating": "5"
    }
  }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
],
{%- endif -%}
],
  "size": {
    "@type": "SizeSpecification",
    "hasMeasurement": [
      {%- if product.metafields.custom.altura.value != blank -%}
      {
        "@type": "QuantitativeValue",
        "name": "Altura",
        "value": "{{ product.metafields.custom.altura.value }}",
        "unitCode": "CMT"
      }{%- if product.metafields.custom.largura.value or product.metafields.custom.comprimento.value or product.metafields.custom.diametro.value -%},{%- endif -%}
      {%- endif -%}
      {%- if product.metafields.custom.largura.value != blank -%}
      {
        "@type": "QuantitativeValue",
        "name": "Largura",
        "value": "{{ product.metafields.custom.largura.value }}",
        "unitCode": "CMT"
      }{%- if product.metafields.custom.comprimento.value or product.metafields.custom.diametro.value -%},{%- endif -%}
      {%- endif -%}
      {%- if product.metafields.custom.comprimento.value != blank -%}
      {
        "@type": "QuantitativeValue",
        "name": "Comprimento",
        "value": "{{ product.metafields.custom.comprimento.value }}",
        "unitCode": "CMT"
      }{%- if product.metafields.custom.diametro.value -%},{%- endif -%}
      {%- endif -%}
      {%- if product.metafields.custom.diametro.value != blank -%}
      {
        "@type": "QuantitativeValue",
        "name": "Diâmetro",
        "value": "{{ product.metafields.custom.diametro.value }}",
        "unitCode": "CMT"
      }
      {%- endif -%}
    ]
  },
  {%- if product.metafields.custom.energy_consumption.value != blank -%}
  ,"hasEnergyConsumptionDetails": {
    "@type": "EnergyConsumptionDetails",
    "energyEfficiencyScaleMax": "A",  
    "energyEfficiencyScaleMin": "G",
    "hasEnergyEfficiencyCategory": "{{ product.metafields.custom.energy_consumption.value }}"
  }
  {%- endif -%},
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
  ,"isRelatedTo": [
    {%- for related_product in recommendations.products -%}
    {
      "@type": "Product",
      "name": "{{ related_product.title }}",
      "url": "{{ shop.url }}{{ related_product.url }}",
      "image": "{{ related_product.featured_image | image_url }}",
      "brand": {
        "@type": "Brand",
        "name": "{{ related_product.vendor }}"
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "{{ cart.currency.iso_code }}",
        "price": "{{ related_product.variants.first.price | money_without_currency }}",
        "availability": "{% if related_product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%},
  "manufacturer": {
    "@type": "Organization",
    "name": "ABAZZUR™",
    "url": "https://abazzur.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+55 11 5104-1636",
      "contactType": "customer support",
      "availableLanguage": "Portuguese"
    }
  },
  {%- if product.media != blank -%}
  ,"hasVideo": {
    "@type": "VideoObject",
    "name": "{{ product.title }}",
    "description": "{{ product.description | strip_html | truncate: 150 }}",
    {%- for media in product.media -%}
      {%- if media.media_type == 'video' -%}
      "thumbnailUrl": "{{ media.preview_image | image_url: width: 500 }}",
      "uploadDate": "{{ media.created_at | date: '%Y-%m-%d' }}",
      "contentUrl": "{{ media.sources.first.url }}",
      "embedUrl": "{{ media.alt | default: media.sources.first.url }}",
      "publisher": {
        "@type": "Organization",
        "name": "ABAZZUR",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ shop.logo | image_url: width: 250 }}"
        }
      }
      {%- endif -%}
    {%- endfor -%}
  }
  {%- endif -%},
  "hasVariant": [
    {%- for variant in product.variants -%}
    {
      "@type": "Product",
      "name": "{{ product.title }} - {{ variant.title }}",
      "sku": "{{ variant.sku }}",
      "url": "{{ shop.url }}{{ variant.url }}",
      "image": "{{ variant.featured_image | image_url }}",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "{{ cart.currency.iso_code }}",
        "price": "{{ variant.price | money_without_currency }}",
        "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
      },
      "additionalProperty": [
        {%- if product.metafields.custom.material.value != blank -%}
        {
          "@type": "PropertyValue",
          "name": "Material",
          "value": "{{ product.metafields.custom.material.value | remove: '[' | remove: ']' | remove: '\"' }}"
        }{%- if product.metafields.custom.ambientes_indicados.value != blank or product.metafields.custom.tensao.value != blank -%},{%- endif -%}
        {%- endif -%}
        {%- if product.metafields.custom.ambientes_indicados.value != blank -%}
        {
          "@type": "PropertyValue",
          "name": "Ambientes Indicados",
          "value": "{{ product.metafields.custom.ambientes_indicados.value | remove: '[' | remove: ']' | remove: '\"' }}"
        }{%- if product.metafields.custom.tensao.value != blank -%},{%- endif -%}
        {%- endif -%}
        {%- if product.metafields.custom.tensao.value != blank -%}
        {
          "@type": "PropertyValue",
          "name": "Tensão",
          "value": "{{ product.metafields.custom.tensao.value }}"
        }
        {%- endif -%}
      ]
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "additionalProperty": [
    {%- if product.metafields.shopify.color-pattern.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Cor",
      "value": "{{ product.metafields.shopify.color-pattern.value | join: ', ' }}"
    }{%- if product.metafields.custom.material.value != blank or product.metafields.custom.acabamento.value != blank or product.metafields.custom.estilo.value != blank or product.metafields.custom.ambientes_indicados.value != blank -%},{%- endif -%}
    {%- endif -%}
    {%- if product.metafields.custom.material.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Material",
      "value": "{{ product.metafields.custom.material.value | join: ', ' }}"
    }{%- if product.metafields.custom.acabamento.value != blank or product.metafields.custom.estilo.value != blank or product.metafields.custom.ambientes_indicados.value != blank -%},{%- endif -%}
    {%- endif -%}
    {%- if product.metafields.custom.acabamento.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Acabamento",
      "value": "{{ product.metafields.custom.acabamento.value }}"
    }{%- if product.metafields.custom.estilo.value != blank or product.metafields.custom.ambientes_indicados.value != blank -%},{%- endif -%}
    {%- endif -%}
    {%- if product.metafields.custom.estilo.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Estilo",
      "value": "{{ product.metafields.custom.estilo.value }}"
    }{%- if product.metafields.custom.ambientes_indicados.value != blank -%},{%- endif -%}
    {%- endif -%}
    {%- if product.metafields.custom.ambientes_indicados.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Ambientes Indicados",
      "value": "{{ product.metafields.custom.ambientes_indicados.value | join: ', ' }}"
    },
    {%- endif -%}
    {%- if product.metafields.custom.potencia_total.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Potência Total",
      "value": "{{ product.metafields.custom.potencia_total.value }} W"
    },
    {%- endif -%}
    {%- if product.metafields.custom.vida_util_media.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Vida Útil Média",
      "value": "{{ product.metafields.custom.vida_util_media.value }} horas"
    },
    {%- endif -%}
    {%- if product.metafields.custom.instalacao.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Instalação",
      "value": "{{ product.metafields.custom.instalacao.value }}"
    },
    {%- endif -%}
    {%- if product.metafields.custom.tipo_de_interruptor.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Tipo de Interruptor",
      "value": "{{ product.metafields.custom.tipo_de_interruptor.value }}"
    },
    {%- endif -%}
    {%- if product.metafields.custom.cabo_de_alimentacao.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Cabo de Alimentação",
      "value": "{{ product.metafields.custom.cabo_de_alimentacao.value }}"
    },
    {%- endif -%}
    {%- if product.metafields.custom.certificacoes.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Certificações",
      "value": "{{ product.metafields.custom.certificacoes.value | join: ', ' }}"
    },
    {%- endif -%}
    {%- if product.metafields.custom.contem_na_embalagem.value != blank -%}
    {
      "@type": "PropertyValue",
      "name": "Contém na Embalagem",
      "value": "{{ product.metafields.custom.contem_na_embalagem.value }}"
    }
    {%- endif -%}
  ]
}
</script>