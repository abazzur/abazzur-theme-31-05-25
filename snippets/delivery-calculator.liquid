// === 1) Tabela de prazos fixos: [minDays, maxDays] ===
const PRAZOS = {
  capitais: {
    "ARACAJU": [5, 9],
    "BELEM": [5, 10],
    "BELO HORIZONTE": [4, 9],
    "BOA VISTA": [5, 10],
