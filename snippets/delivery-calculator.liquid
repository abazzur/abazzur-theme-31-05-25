<script src="{{ 'lottie.min.js' | asset_url }}" defer></script>

<div class="delivery-calculator">
  <h3 class="delivery-calculator__title">Calcular prazo</h3>
  
  <div class="delivery-calculator__form">
    <!-- Grupo dos 5 dígitos -->
    <div class="delivery-calculator__input-group delivery-calculator__cep-group">
      {% for i in (0..4) %}
        <div class="delivery-calculator__field">
          <input
            type="text"
            class="delivery-calculator__input js-cep-digit"
            data-index="{{ i }}"
            maxlength="1"
            pattern="[0-9]"
            inputmode="numeric"
          >
        </div>
      {% endfor %}
    </div>
    
    <!-- Separador -->
    <span class="delivery-calculator__separator">-</span>
    
    <!-- Grupo dos 3 dígitos -->
    <div class="delivery-calculator__input-group delivery-calculator__sufix-group">
      {% for i in (0..2) %}
        <div class="delivery-calculator__field">
          <input
            type="text"
            class="delivery-calculator__input js-sufix-digit"
            data-index="{{ i }}"
            maxlength="1"
            pattern="[0-9]"
            inputmode="numeric"
          >
        </div>
      {% endfor %}
    </div>
    
    <!-- Animação "Search" -->
    <div class="delivery-calculator__loading-search" style="width:45px; height:45px; display:none;"></div>
  </div>
  
  <p class="delivery-calculator__hint">Insira seu CEP</p>
  
  <!-- Local em que exibimos FRETE EXPRESSO + datas -->
  <div class="delivery-calculator__results"></div>
</div>

<style>
.delivery-calculator {
  width: 100%;
  margin: 25px 0;
}
.delivery-calculator__title {
  font-size: 18px;
  font-weight: 600;
  font-family: 'Inter', sans-serif;
  color: #000;
  margin-bottom: 20px;
  text-align: left;
}
.delivery-calculator__form {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 6px;
}
.delivery-calculator__input-group {
  display: flex;
  border: 1px solid #E0E0E0;
  border-radius: 10px;
  overflow: hidden;
}
.delivery-calculator__cep-group { width: 225px; }
.delivery-calculator__sufix-group { width: 135px; }

.delivery-calculator__field {
  flex: 1;
  position: relative;
}
.delivery-calculator__input {
  width: 100%;
  height: 45px;
  border: none;
  text-align: center;
  font-size: 14px;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  color: #999;
  padding: 0;
}
.delivery-calculator__input:focus {
  outline: none;
}

.delivery-calculator__field:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 25%;
  height: 50%;
  width: 1px;
  background-color: #E0E0E0;
}

.delivery-calculator__separator {
  font-size: 24px;
  font-weight: 300;
  color: #999;
  display: flex;
  align-items: center;
}

.delivery-calculator__hint {
  font-size: 11px;
  color: #999;
  font-weight: 400;
  text-align: left;
  margin-left: 5px;
}

.delivery-calculator__results {
  margin-top: 15px;
  font-size: 16px;
  color: #000;
  font-weight: 400;
}

.delivery-calculator__loading-search {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* NOVO CSS PARA O CARD DE RESULTADO DO FRETE */
.shipping-card {
  background-color: #F8F8F8;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px;
  margin-top: 1rem;
  border-radius: 8px;
    gap: 12px;
  min-height: 100px;
}

/* Container da coluna esquerda (ícone + textos) */
.shipping-card__left {
  display: flex;
  align-items: flex-start;
      gap: 12px;
}

/* Container apenas do ícone */
.shipping-card__icon {
  flex-shrink: 0;
}

.shipping-card__icon svg {
  width: 32px;
  height: 32px;
  color: #000;
margin-right: 10px;
}

/* Container dos textos alinhados verticalmente */
.shipping-card__info {
  display: flex;
  flex-direction: column;
}

/* Título "Receba em casa" */
.shipping-card__title {
  font-size: 1.5rem;
  font-weight: 600;
  color: #000;
  margin-bottom: 0px;
}

/* "Frete expresso" e cidade */
.shipping-card__express {
  color: #999;
  font-size: 11px;
  font-weight: 400;
  margin-bottom: 10px;
}

.shipping-card__city {
  color: #999;
  font-size: 11px;
  font-weight: 400;
}

/* Data de entrega */
.shipping-card__date {
  color: #999;
  font-size: 11px;
  font-weight: 400;
}

/* Badge "Grátis" */
.shipping-card__badge {
  background-color: #EEF6EE;
  color: #0d8756;
  font-size: 10px;
  font-weight: 700;
  padding: 5px 14px;
  border-radius: 4px;
  height: fit-content;
}

/* Responsivo no mobile */
@media (max-width: 480px) {
  .delivery-calculator__cep-group {
    width: 180px;
  }
  .delivery-calculator__sufix-group {
    width: 108px;
  }
  .delivery-calculator__input {
    font-size: 16px;
  }
  
  /* Ajustes responsivos para o card de frete */
  .shipping-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 20px;
  }
  
  .shipping-card__badge {
    align-self: flex-start;
  }
}
</style>

