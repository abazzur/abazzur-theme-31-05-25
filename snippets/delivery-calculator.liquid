// === 2) Script principal ===
document.addEventListener('DOMContentLoaded', () => {
  // Seletores
  const cepInputs = document.querySelectorAll('.js-cep-digit');
  const sufixInputs = document.querySelectorAll('.js-sufix-digit');
  const loadingSearchDiv = document.querySelector('.delivery-calculator__loading-search');
  const resultsDiv = document.querySelector('.delivery-calculator__results');

  // Animação do SEARCH
  let searchLottie = lottie.loadAnimation({
    container: loadingSearchDiv,
    renderer: 'svg',
    loop: true,
    autoplay: false,
    animationData: searchAnimationData
  });

  // === Avanço automático CEP (5 campos) ===
  cepInputs.forEach((input, idx) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '');
      if (input.value) {
        if (idx < 4) {
          cepInputs[idx + 1].focus();
        } else {
          // foca no primeiro do sufix
          sufixInputs[0].focus();
        }
      }
    });
    // backspace
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && idx > 0) {
        cepInputs[idx - 1].focus();
      }
    });
  });

  // === Avanço automático sufix (3 campos) ===
  sufixInputs.forEach((input, idx) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '');
      if (input.value && idx < 2) {
        sufixInputs[idx + 1].focus();
      }
      if (idx === 2 && input.value) {
        const full = getFullCep();
        if (full.length === 8) {
          iniciarLoading();
        }
      }
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && idx > 0) {
        sufixInputs[idx - 1].focus();
      }
    });
  });

  // Retorna CEP completo
  function getFullCep() {
    let partA = '';
    cepInputs.forEach(i => partA += (i.value || ''));
    let partB = '';
    sufixInputs.forEach(i => partB += (i.value || ''));
    return partA + partB;
  }

  // === Exibe animação Search por 2.5s e depois faz viaCEP ===
  function iniciarLoading() {
    resultsDiv.innerHTML = '';
    loadingSearchDiv.style.display = 'flex';
    searchLottie.goToAndPlay(0, true);

    setTimeout(() => {
      searchLottie.stop();
      loadingSearchDiv.style.display = 'none';
      buscarPrazo();
    }, 2500);
  }

// === Chama viaCEP e exibe resultado ===
  async function buscarPrazo() {
    let fullCep = getFullCep();
    if (fullCep.length < 8) return;
    try {
      const url = `https://viacep.com.br/ws/${fullCep}/json/`;
      const resp = await fetch(url);
      if (!resp.ok) throw new Error('ViaCEP error');
      const data = await resp.json();
      if (data.erro) throw new Error('CEP inválido');
      const uf = (data.uf || '').toUpperCase();
      const city = (data.localidade || '').toUpperCase();
      let [minDays, maxDays] = PRAZOS.others; // Default
      if (uf === 'SP') {
        if (city in PRAZOS.capitais) {
          [minDays, maxDays] = PRAZOS.capitais[city];
        } else {
          [minDays, maxDays] = PRAZOS.rest_SP;
        }
      } else if (city in PRAZOS.capitais) {
        [minDays, maxDays] = PRAZOS.capitais[city];
      }
      const dateMin = addDays(minDays);
      const dateMax = addDays(maxDays);
      const strMin = formatDateBR(dateMin);
      const strMax = formatDateBR(dateMax);
      exibirResultado(data.localidade, data.uf, strMin, strMax);
    } catch(e) {
      resultsDiv.innerHTML = '';
    }
  }
  
  // Retorna nova data somando apenas dias úteis (pula sábados e domingos)
  function addDays(daysToAdd) {
    const dt = new Date();
    let addedDays = 0;
    
    while (addedDays < daysToAdd) {
      dt.setDate(dt.getDate() + 1);
      
      // Verifica se não é fim de semana (0 = Domingo, 6 = Sábado)
      if (dt.getDay() !== 0 && dt.getDay() !== 6) {
        addedDays++;
      }
    }
    
    return dt;
  }
  
  // Formata a data em pt-BR
  function formatDateBR(d) {
    return d.toLocaleDateString('pt-BR', {
      day: 'numeric',
      month: 'long',
    });
  }
  
  // === Exibe FRETE EXPRESSO + intervalo de data ===
